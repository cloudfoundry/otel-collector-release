<%=
  env_vars = { "NO_WINDOWS_SERVICE" => "1",
               'GOMEMLIMIT' => "#{(p('limits.memory_mib').to_i * 0.80).floor}MiB" }
  if_p('limits.cpu') { |cpu| env_vars['GOMAXPROCS'] = cpu.to_i }

  if p('inject_bosh_env')
    env_vars.merge!({
      'BOSH_DEPLOYMENT' => spec.deployment.to_s,
      'BOSH_NAME' => spec.name.to_s,
      'BOSH_ID' => spec.id.to_s,
      'BOSH_INDEX' => spec.index.to_s,
      'BOSH_AZ' => spec.az.to_s,
      'BOSH_ADDRESS' => spec.address.to_s,
      'BOSH_IP' => spec.ip.to_s
    })
  end

  process = {
    "name" => "otel-collector",
    "executable" => "/var/vcap/packages/otel-collector-windows/otel-collector.exe",
    "args" => ["--config", "/var/vcap/jobs/otel-collector-windows/config/config.yml"],
    "env" => env_vars
  }
  
  monit = { "processes" => [] }
  if p('enabled')
    monit["processes"] = [process]
  end

  JSON.pretty_generate(monit)
%>
