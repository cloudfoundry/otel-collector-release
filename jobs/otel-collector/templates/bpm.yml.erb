<%=
  configs = p('configs')
  config_args =
    if configs.empty?
      ['--config', '/var/vcap/jobs/otel-collector/config/config.yml']
    else
      configs.each_with_index.flat_map do |entry, i|
        name = (entry['name'] || "cfg#{i}").gsub(/[^a-zA-Z0-9_-]/, '_')
        ['--config', format('/var/vcap/jobs/otel-collector/config/config-%03d-%s.yml', i, name)]
      end
    end

  bpm = {
    'processes' => [
        {
          'name' => 'otel-collector',
          'executable' => '/var/vcap/packages/otel-collector/otel-collector',
          'args' => config_args,
          'env' => { 'GOMEMLIMIT' => "#{(p('limits.memory_mib').to_i * 0.80).floor}MiB" },
          'limits' => { 'memory' => "#{p('limits.memory_mib')}MiB" }
        }
      ]
    }

    if_p('limits.cpu') do |cpu|
      bpm['processes'][0]['env']['GOMAXPROCS'] = cpu.to_i
    end

    YAML.dump(bpm)
%>
