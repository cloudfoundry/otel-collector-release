#!/bin/bash
set -e -x

source /var/vcap/packages/golang-1.26-linux/bosh/compile.env

export CGO_ENABLED=0

pushd otel-collector-builder
  go run go.opentelemetry.io/collector/cmd/builder --config=config.yaml --skip-generate --skip-get-modules
popd

cp "otel-collector/otelcol-cf" "${BOSH_INSTALL_TARGET}/otel-collector"

# Generate a list of available Otel Collector components and put it into the config directory
mkdir -p "${BOSH_INSTALL_TARGET}/config"
ruby "${BOSH_COMPILE_TARGET}/src/lib/generate_available_components.rb" \
     "${BOSH_COMPILE_TARGET}" \
     "${BOSH_INSTALL_TARGET}/config/available_components.yml"
